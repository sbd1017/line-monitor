[Unit]
Description=speedmon: consistent database backup (keeps the newest 60) + verification of the copy

[Service]
Type=oneshot
User=speedmon
Group=speedmon
WorkingDirectory=/home/pi/line-monitor
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SPEEDMON_ENV=production
Environment=SPEEDMON_DATA_DIR=/home/pi/line-monitor/var
ExecStart=/home/pi/line-monitor/.venv/bin/python -m speedmon.cli backup --keep 60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/line-monitor/var
IPAddressDeny=any
Nice=10
IOSchedulingClass=idle
