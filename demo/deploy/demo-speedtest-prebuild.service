[Unit]
Description=Line Monitor demo: build tomorrow's three years of generated data ahead of the 04:00 reset
# The reset takes over if this hasn't finished by then.
Conflicts=demo-speedtest-reset.service

[Service]
Type=oneshot
User=demo
Group=demo
WorkingDirectory=/opt/demos/speedtest/app
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SPEEDMON_DATA_DIR=/srv/demos/speedtest
ExecStart=/opt/demos/speedtest/venv/bin/python -m demo.generate --no-swap --verify
TimeoutStartSec=30min
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=1200M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/demos/speedtest
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
